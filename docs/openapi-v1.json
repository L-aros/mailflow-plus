                "code": "invalid_request",
                "message": "Invalid, unknown or repeated query parameter."
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "An API token is required, invalid, expired or revoked, or the administrator has disabled API Tokens.",
        "headers": {
          "Cache-Control": {
            "description": "Always no-store.",
            "schema": {
              "type": "string",
