{
  "openapi": "3.1.0",
  "info": {
    "title": "MailFlow Plus Read API",
    "version": "1.0.0",
    "description": "Stable versioned read adapter over existing MailFlow services. All endpoints require an enabled, valid API Token with read scope; browser cookies alone do not authenticate v1. Existing token limits apply: 600 requests/5 minutes/token, 1200/5 minutes/user, and 60 searches/minute/user shared across token search endpoints, separate from browser search. Unknown/repeated query parameters are rejected. Canonical method/path allowlisting occurs before route validation. Within v1, clients should ignore additional response fields. No schema migration, sending, deleting, attachment downloads or Webhooks are introduced."
  },
  "servers": [
    {
      "url": "https://mailflow.example.com",
      "description": "Placeholder: replace with your MailFlow instance origin."
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "externalDocs": {
    "description": "Usage, resource identity, pagination, errors, examples and compatibility policy",
    "url": "https://github.com/L-aros/mailflow-plus/blob/mailflow-plus/docs/api-v1.md"
  },
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "List enabled accounts",
        "description": "Lists only enabled accounts owned by the token user, ordered by configured sort order, creation time and ID. No connection credentials or settings are included.",
        "x-required-scopes": [
          "read"
        ],
        "x-reject-unknown-query-parameters": true,
        "x-reject-repeated-query-parameters": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read.",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
