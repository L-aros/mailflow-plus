        "headers": {
          "Cache-Control": {
            "description": "Always no-store.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "forbidden",
                "message": "A valid token lacks read scope or the request method/path is not allowlisted, including malformed path UUIDs."
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource is missing, deleted, foreign, or belongs to a disabled account.",
        "headers": {
          "Cache-Control": {
            "description": "Always no-store.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
