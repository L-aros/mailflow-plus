# MailFlow Plus offline/self-owned image install. Copy to .env and fill every
# required blank. Read docs/release-operations.md before exposing the service.
# Select the exact two tags from release-manifest.json after docker load.
MAILFLOW_BACKEND_IMAGE=
MAILFLOW_FRONTEND_IMAGE=

# Localhost only until the intended HTTPS proxy and firewall are configured.
APP_PORT=127.0.0.1:8443
APP_HTTP_PORT=127.0.0.1:8080
APP_URL=https://localhost:8443
NGINX_TLS=on
TRUST_PROXY_HOPS=1

# Generate each independently: openssl rand -hex 32
SESSION_SECRET=
DB_PASSWORD=
# Keep this exact value with the matched encrypted configuration snapshot.
ENCRYPTION_KEY=

# Optional web push. Keep private keys in the encrypted configuration backup.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional Caddy profile; do not enable before selecting the real domain/target.
DOMAIN=
ACME_EMAIL=

# Only needed with docker-compose.plus-build.yml, from a clean checkout.
GIT_SHA=
PLUS_VERSION=
